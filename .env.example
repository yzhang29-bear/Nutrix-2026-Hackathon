# Copy to .env and fill in. Read by the scripts in scripts/ (export them: set -a; . ./.env; set +a)
AWS_PROFILE=nutrix
AWS_REGION=us-west-2
MODEL_VERSION=v7-20261010
# Shared key the service checks in the x-api-key header (until API Gateway auth is set up)
PMRF_API_KEY=
# Local CGMacros copy used by the integration tests (./ops/data/sync_data.sh pull)
CGMACROS_DIR=data/CGMacros
# Required for the Clerk-protected mobile gateway routes. These values are set
# in the Clerk session-token template and are not secrets.
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts
CLERK_JWT_AUDIENCE=nutrix-mobile
# Browser origins allowed to call the gateway. Native Expo clients do not use CORS.
MOBILE_CORS_ORIGINS=http://localhost:8081,http://localhost:8082
# PMRF patient IDs assigned by the signed Clerk pmrf_person_id claim for this demo.
MOBILE_DEMO_PERSON_IDS=cgmacros-003,cgmacros-002
